<script type="module">
  /* Keep these in step with the EVENT block in api/register.js */
  const CONFIG = { cohortSize: 147, contactEmail: "organizers@example.com" };

  (function drawCohort() {
    const grid = document.getElementById("cohortGrid");
    const frag = document.createDocumentFragment();
    for (let i = 0; i < CONFIG.cohortSize; i++) {
      const dot = document.createElement("span");
      dot.style.animationDelay = `${i * 6}ms`;
      frag.appendChild(dot);
    }
    grid.appendChild(frag);
    document.getElementById("cohortCount").textContent = CONFIG.cohortSize;
  })();

  const contact = document.getElementById("contactLink");
  contact.textContent = CONFIG.contactEmail;
  contact.href = `mailto:${CONFIG.contactEmail}`;

  const form = document.getElementById("form");
  const button = document.getElementById("submit");
  const status = document.getElementById("status");

  function clearErrors() {
    for (const field of form.querySelectorAll(".field")) field.classList.remove("has-error");
    status.textContent = "";
  }

  function showErrors(errors) {
    let first = null;
    for (const [key, message] of Object.entries(errors)) {
      const field = document.getElementById(`f-${key}`);
      const slot = document.getElementById(`e-${key}`);
      if (!field || !slot) continue;
      field.classList.add("has-error");
      slot.textContent = message;
      if (!first) first = document.getElementById(key);
    }
    if (first) first.focus();
  }

  form.addEventListener("submit", async (submitEvent) => {
    submitEvent.preventDefault();
    clearErrors();

    const payload = {
      name: form.name.value,
      email: form.email.value,
      cohort: form.cohort.value,
      organization: form.organization.value,
      role: form.role.value,
      notes: form.notes.value,
      consent: form.consent.checked,
      company_website: form.company_website.value,
    };

    button.disabled = true;
    button.textContent = "Registering...";

    try {
      const response = await fetch("/api/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        if (result.errors) showErrors(result.errors);
        status.textContent = result.error || "That didn't go through. Try again.";
        return;
      }

      document.getElementById("sentTo").textContent = payload.email;
      if (result.confirmationSent === false) document.getElementById("doneWarn").hidden = false;
      const dots = document.querySelectorAll("#cohortGrid span");
      if (dots.length) dots[Math.floor(dots.length / 2)].classList.add("is-you");
      document.body.classList.add("is-done");
      document.getElementById("done").focus();
    } catch {
      status.textContent = `Couldn't reach the server. Check your connection, or email ${CONFIG.contactEmail}.`;
    } finally {
      button.disabled = false;
      button.textContent = "Register";
    }
  });
</script>
</body>
</html>
HTMLEOF

