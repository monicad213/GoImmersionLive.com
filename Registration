cat > api/register.js <<'APIEOF'
import nodemailer from "nodemailer";

/* ===========================================================================
   1. EDIT YOUR EVENT DETAILS HERE
   =========================================================================== */
const EVENT = {
  name: "Immersion Week",
  programName: "MIT Program Cohort",
  dates: "Monday 12 - Friday 16 October 2026",
  location: "Cambridge, MA",
  venue: "Venue TBC - full details to follow",
  contactName: "Immersion Week organizers",
};

/* ===========================================================================
   2. Everything below works as-is.
   =========================================================================== */

const FROM_NAME = process.env.MAIL_FROM_NAME || "Immersion Week";
const FROM_EMAIL = process.env.MAIL_FROM_EMAIL || "organizers@example.com";
const CONTACT = process.env.CONTACT_EMAIL || FROM_EMAIL;
const ORGANIZERS = (process.env.ORGANIZER_EMAILS || "")
  .split(",").map((a) => a.trim()).filter(Boolean);

/* ---------- validation ---------- */

const EMAIL_PATTERN = /^[^\s@]+@[^\s@.]+\.[^\s@]{2,}$/;

function clean(value, max) {
  if (typeof value !== "string") return "";
  return value.replace(/\s+/g, " ").trim().slice(0, max);
}

function validate(body) {
  const data = {
    name: clean(body.name, 120),
    email: clean(body.email, 254).toLowerCase(),
    cohort: clean(body.cohort, 80),
    organization: clean(body.organization, 160),
    role: clean(body.role, 120),
    notes: clean(body.notes, 1000),
    consent: body.consent === true || body.consent === "true" || body.consent === "on",
  };
  const errors = {};
  if (data.name.length < 2) errors.name = "Enter your full name.";
  if (!EMAIL_PATTERN.test(data.email))
    errors.email = "Enter an email address we can send your confirmation to.";
  if (!data.cohort)
    errors.cohort = "Tell us which program and year, so we can seat you with your cohort.";
  if (!data.consent) errors.consent = "Tick the box so we can email you about this event.";
  return { ok: Object.keys(errors).length === 0, data, errors };
}

/* ---------- email bodies ---------- */

// Registrant input is echoed into both emails, so it is escaped first.
function esc(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}

const LABEL =
  "font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:.14em;" +
  "text-transform:uppercase;color:#4a5875;";

const shell = (inner) => `<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#e9edf1;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#e9edf1;padding:32px 16px;">
<tr><td align="center"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"
style="max-width:560px;background:#ffffff;border:1px solid #c3cdd8;">
<tr><td style="padding:32px;font-family:Georgia,serif;font-size:16px;line-height:1.6;color:#0f1b33;">
${inner}
</td></tr></table></td></tr></table></body></html>`;

function rows(pairs) {
  return pairs.filter(([, v]) => v).map(([label, value]) => `
<tr><td style="padding:8px 16px 8px 0;vertical-align:top;white-space:nowrap;${LABEL}">${esc(label)}</td>
<td style="padding:8px 0;vertical-align:top;font-family:Georgia,serif;font-size:15px;color:#0f1b33;">${esc(value)}</td></tr>`
  ).join("");
}

function confirmationEmail(d) {
  const first = d.name.split(" ")[0];
  return {
    subject: `You're registered - ${EVENT.name}, ${EVENT.dates}`,
    html: shell(`
<p style="margin:0 0 20px;${LABEL}">${esc(EVENT.programName)}</p>
<h1 style="margin:0 0 20px;font-family:Georgia,serif;font-size:28px;line-height:1.2;font-weight:normal;color:#0f1b33;">You're registered for ${esc(EVENT.name)}.</h1>
<p style="margin:0 0 24px;">Thanks, ${esc(first)}. Your place is held. Here is what we have for you:</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-top:1px solid #c3cdd8;border-bottom:1px solid #c3cdd8;margin:0 0 24px;">
${rows([["When", EVENT.dates], ["Where", `${EVENT.venue}, ${EVENT.location}`],
        ["Name", d.name], ["Email", d.email], ["Cohort", d.cohort],
        ["Organization", d.organization], ["Role", d.role], ["Notes", d.notes]])}
</table>
<p style="margin:0 0 12px;"><strong>What happens next</strong></p>
<p style="margin:0 0 24px;">We'll send the schedule, venue address and travel notes closer to the date. Add this address to your contacts so those don't land in spam.</p>
<p style="margin:0 0 24px;">Something wrong above, or need to cancel? Reply to this email and we'll fix it.</p>
<p style="margin:0;font-size:14px;color:#4a5875;">${esc(EVENT.contactName)} &middot; <a href="mailto:${esc(CONTACT)}" style="color:#0e6e63;">${esc(CONTACT)}</a></p>`),
    text: [
      `You're registered for ${EVENT.name}.`, ``,
      `Thanks, ${first}. Your place is held.`, ``,
      `When:  ${EVENT.dates}`,
      `Where: ${EVENT.venue}, ${EVENT.location}`,
      `Name:  ${d.name}`,
      `Email: ${d.email}`,
      d.cohort ? `Cohort: ${d.cohort}` : null,
      d.organization ? `Organization: ${d.organization}` : null,
      d.role ? `Role: ${d.role}` : null,
      d.notes ? `Notes: ${d.notes}` : null, ``,
      `We'll send the schedule and venue details closer to the date.`,
      `Something wrong, or need to cancel? Just reply to this email.`, ``,
      `${EVENT.contactName} - ${CONTACT}`,
    ].filter((l) => l !== null).join("\n"),
  };
}

function organizerEmail(d, meta) {
  return {
    subject: `New registration: ${d.name}${d.cohort ? ` (${d.cohort})` : ""}`,
    html: shell(`
<p style="margin:0 0 20px;${LABEL}">${esc(EVENT.name)} &middot; new registration</p>
<h1 style="margin:0 0 24px;font-family:Georgia,serif;font-size:24px;line-height:1.25;font-weight:normal;color:#0f1b33;">${esc(d.name)}</h1>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-top:1px solid #c3cdd8;border-bottom:1px solid #c3cdd8;margin:0 0 24px;">
${rows([["Email", d.email], ["Cohort", d.cohort], ["Organization", d.organization],
        ["Role", d.role], ["Notes", d.notes], ["Registered", meta.registeredAt]])}
</table>
<p style="margin:0;font-size:14px;color:#4a5875;">Reply directly to <a href="mailto:${esc(d.email)}" style="color:#0e6e63;">${esc(d.email)}</a> to reach them.</p>`),
    text: [
      `New registration - ${EVENT.name}`, ``,
      `Name:  ${d.name}`,
      `Email: ${d.email}`,
      d.cohort ? `Cohort: ${d.cohort}` : null,
      d.organization ? `Organization: ${d.organization}` : null,
      d.role ? `Role: ${d.role}` : null,
      d.notes ? `Notes: ${d.notes}` : null,
      `Registered: ${meta.registeredAt}`,
    ].filter((l) => l !== null).join("\n"),
  };
}

/* ---------- mail transport ---------- */

let transport;
function getTransport() {
  if (transport) return transport;
  const missing = ["SMTP_HOST", "SMTP_USER", "SMTP_PASS"].filter((k) => !process.env[k]);
  if (missing.length) throw new Error(`Missing environment variables: ${missing.join(", ")}`);
  const port = Number(process.env.SMTP_PORT || 587);
  transport = nodemailer.createTransport({
    host: process.env.SMTP_HOST,
    port,
    secure: port === 465,
    auth: { user: process.env.SMTP_USER, pass: process.env.SMTP_PASS },
  });
  return transport;
}

const from = () => `"${FROM_NAME}" <${FROM_EMAIL}>`;

function sendConfirmation(d) {
  const { subject, html, text } = confirmationEmail(d);
  return getTransport().sendMail({ from: from(), to: d.email, replyTo: CONTACT, subject, html, text });
}

function sendOrganizerNotice(d, meta) {
  if (!ORGANIZERS.length) throw new Error("ORGANIZER_EMAILS is not set - nobody would be notified.");
  const { subject, html, text } = organizerEmail(d, meta);
  return getTransport().sendMail({
    from: from(), to: ORGANIZERS.join(", "), replyTo: d.email, subject, html, text,
  });
}

/* ---------- optional webhook (Google Sheet, Zapier, Make) ---------- */

// Returns true only if a registration was genuinely delivered somewhere. An
// unconfigured webhook must never be mistaken for a successful save.
async function forwardToWebhook(payload) {
  const url = process.env.REGISTRATIONS_WEBHOOK_URL;
  if (!url) return false;
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 5000);
  try {
    const response = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
      signal: controller.signal,
    });
    if (!response.ok) throw new Error(`Webhook responded ${response.status}`);
    return true;
  } finally {
    clearTimeout(timeout);
  }
}

/* ---------- rate limit ---------- */

// Best effort: lives in one instance's memory, so it slows a single noisy
// client rather than guaranteeing a global cap. Enough for a private event.
const WINDOW_MS = 10 * 60 * 1000;
const MAX_PER_WINDOW = 5;
const hits = new Map();

function rateLimited(ip) {
  const now = Date.now();
  const recent = (hits.get(ip) || []).filter((t) => now - t < WINDOW_MS);
  recent.push(now);
  hits.set(ip, recent);
  if (hits.size > 5000) hits.clear();
  return recent.length > MAX_PER_WINDOW;
}

function clientIp(req) {
  const fwd = req.headers["x-forwarded-for"];
  if (typeof fwd === "string") return fwd.split(",")[0].trim();
  return req.socket?.remoteAddress || "unknown";
}

/* ---------- handler ---------- */

export default async function handler(req, res) {
  if (req.method === "OPTIONS") {
    res.setHeader("Allow", "POST, OPTIONS");
    return res.status(204).end();
  }
  if (req.method !== "POST") {
    res.setHeader("Allow", "POST, OPTIONS");
    return res.status(405).json({ error: "Use POST to register." });
  }

  let body = req.body || {};
  if (typeof body === "string") { try { body = JSON.parse(body); } catch { body = {}; } }

  // Honeypot: hidden from people, filled in by naive bots. Answer as if it
  // worked, so the bot learns nothing.
  if (body.company_website) return res.status(200).json({ ok: true });

  if (rateLimited(clientIp(req))) {
    return res.status(429).json({
      error: "That's a lot of registrations from one place. Try again in a few minutes.",
    });
  }

  const { ok, data, errors } = validate(body);
  if (!ok) return res.status(400).json({ error: "Some details need fixing.", errors });

  const meta = { registeredAt: new Date().toISOString() };

  const [confirmation, notice, webhook] = await Promise.allSettled([
    sendConfirmation(data),
    sendOrganizerNotice(data, meta),
    forwardToWebhook({ ...data, ...meta }),
  ]);

  for (const [label, result] of [
    ["confirmation email", confirmation],
    ["organizer email", notice],
    ["webhook", webhook],
  ]) {
    if (result.status === "rejected") {
      console.error(`[register] ${label} failed for ${data.email}:`, result.reason?.message);
    }
  }

  // The signup counts as captured if it reached the organizers by any route.
  // A failed confirmation is worth flagging but not worth losing a registration.
  const captured =
    notice.status === "fulfilled" || (webhook.status === "fulfilled" && webhook.value === true);

  if (!captured) {
    return res.status(502).json({
      error: `We couldn't record that. Please email ${CONTACT} directly.`,
    });
  }

  return res.status(200).json({
    ok: true,
    confirmationSent: confirmation.status === "fulfilled",
  });
}
APIEOF

